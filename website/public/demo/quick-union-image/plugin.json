{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload.js",
  "features": [
    {
      "code": "edit",
      "description": "图片编辑：缩放、旋转、翻转、裁切",
      "cmds": [
        "图片编辑",
        "裁剪图片",
        "旋转图片",
        {
          "type": "img",
          "label": "图片编辑"
        },
        {
          "type": "files",
          "label": "图片编辑",
          "fileType": "file",
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "jfif",
            "webp",
            "gif",
            "bmp",
            "tif",
            "tiff",
            "avif",
            "heic",
            "heif",
            "svg",
            "ico"
          ],
          "minLength": 1,
          "maxLength": 500
        }
      ]
    },
    {
      "code": "stitch",
      "description": "图片拼接：固定网格、自由网格、长图拼接",
      "cmds": [
        "图片拼接",
        "拼图",
        "长图拼接",
        {
          "type": "files",
          "label": "图片拼接",
          "fileType": "file",
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "jfif",
            "webp",
            "gif",
            "bmp",
            "tif",
            "tiff",
            "avif",
            "heic",
            "heif",
            "svg",
            "ico"
          ],
          "minLength": 2,
          "maxLength": 500
        },
        {
          "type": "files",
          "label": "文件夹图片拼接",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 20
        }
      ]
    },
    {
      "code": "workflow",
      "description": "图片工作流：把编辑、拼接、导出串联批量执行",
      "cmds": [
        "图片工作流",
        {
          "type": "files",
          "label": "图片工作流",
          "minLength": 1,
          "maxLength": 500
        }
      ]
    },
    {
      "code": "presets",
      "description": "管理拼图网格预设",
      "cmds": [
        "拼图网格预设"
      ]
    },
    {
      "code": "ai",
      "description": "用一句话让 AI 编排图片的编辑、拼接、导出",
      "cmds": [
        "AI 图片编排",
        "AI 拼图",
        {
          "type": "files",
          "label": "AI 图片编排",
          "fileType": "file",
          "extensions": [
            "png",
            "jpg",
            "jpeg",
            "jfif",
            "webp",
            "gif",
            "bmp",
            "tif",
            "tiff",
            "avif",
            "heic",
            "heif",
            "svg",
            "ico"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "files",
          "label": "AI 编排文件夹图片",
          "fileType": "directory",
          "minLength": 1,
          "maxLength": 20
        }
      ]
    }
  ],
  "tools": {
    "list_presets": {
      "description": "列出快拼图的网格预设（内置和用户保存的）和用户保存的图片工作流。调用 stitch_images 或 run_workflow 前用它查看可用的 id。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "edit_images": {
      "description": "批量编辑本地图片：按顺序执行旋转、翻转、裁切、去纯色边、缩放，每张图导出一个新文件，不修改原图。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "图片文件或文件夹的绝对路径；文件夹会展开为其中的图片（按文件名自然排序）"
          },
          "ops": {
            "type": "array",
            "minItems": 1,
            "description": "按顺序执行的编辑操作",
            "items": {
              "type": "object",
              "description": "一个编辑操作，type 决定用哪些字段：rotate(angle, background) / flip(horizontal, vertical) / crop(x, y, w, h，0~1 归一化区域) / cropRatio(ratioW, ratioH, position) / trim(threshold) / resize(mode 及对应字段)",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "rotate",
                    "flip",
                    "crop",
                    "cropRatio",
                    "trim",
                    "resize"
                  ],
                  "description": "操作类型"
                },
                "angle": {
                  "type": "number",
                  "description": "rotate：顺时针角度"
                },
                "background": {
                  "type": "string",
                  "description": "rotate / resize box：空白处颜色，#rrggbb 或 transparent"
                },
                "horizontal": {
                  "type": "boolean",
                  "description": "flip：水平翻转"
                },
                "vertical": {
                  "type": "boolean",
                  "description": "flip：垂直翻转"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "crop：左上角 x（0~1）"
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "crop：左上角 y（0~1）"
                },
                "w": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "crop：宽度（0~1）"
                },
                "h": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "crop：高度（0~1）"
                },
                "ratioW": {
                  "type": "number",
                  "minimum": 0,
                  "description": "cropRatio：宽高比的宽"
                },
                "ratioH": {
                  "type": "number",
                  "minimum": 0,
                  "description": "cropRatio：宽高比的高"
                },
                "position": {
                  "type": "string",
                  "enum": [
                    "center",
                    "top",
                    "bottom",
                    "left",
                    "right",
                    "left top",
                    "right top",
                    "left bottom",
                    "right bottom"
                  ],
                  "description": "cropRatio / resize box：对齐位置"
                },
                "threshold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 255,
                  "description": "trim：颜色容差，默认 10"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "scale",
                    "width",
                    "height",
                    "maxSide",
                    "box"
                  ],
                  "description": "resize：scale 用 scale；width 用 width；height 用 height；maxSide 用 size、onlyShrink；box 用 width、height、fit、position、background"
                },
                "scale": {
                  "type": "number",
                  "minimum": 0,
                  "description": "resize scale：缩放倍数，如 0.5"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "resize width / box：宽度（像素）"
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "resize height / box：高度（像素）"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "resize maxSide：最长边（像素）"
                },
                "onlyShrink": {
                  "type": "boolean",
                  "description": "resize maxSide：为 true 时小图不放大"
                },
                "fit": {
                  "type": "string",
                  "enum": [
                    "cover",
                    "contain",
                    "fill"
                  ],
                  "description": "resize box：适配方式"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "recursive": {
            "type": "boolean",
            "description": "展开文件夹时是否包含子文件夹，默认 false"
          },
          "output_dir": {
            "type": "string",
            "description": "导出目录的绝对路径；不填时导出到第一张源图所在的目录"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp",
              "avif"
            ],
            "description": "导出格式，默认 png"
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "jpeg / webp / avif 的质量，默认 90"
          },
          "name_template": {
            "type": "string",
            "description": "文件名模板（不含扩展名），可用 {name} {index} {date} {time}；重名时自动加序号，不会覆盖已有文件"
          }
        },
        "required": [
          "paths",
          "ops"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "导出的文件",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "failed": {
            "type": "array",
            "description": "读取失败、被跳过的输入",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "files",
          "failed"
        ]
      }
    },
    "stitch_images": {
      "description": "把多张本地图片拼成一张：等高横拼、等宽竖拼、长图、宫格、自由网格等（preset_id 来自 list_presets，默认等高横拼）。图片数超过预设格子数时默认分组输出多张。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "图片文件或文件夹的绝对路径；文件夹会展开为其中的图片（按文件名自然排序）"
          },
          "preset_id": {
            "type": "string",
            "description": "网格预设的 id 或名称，默认 builtin-justify-h（等高横拼）"
          },
          "gap": {
            "type": "number",
            "minimum": 0,
            "description": "图片间距（像素），不填用预设的值"
          },
          "padding": {
            "type": "number",
            "minimum": 0,
            "description": "外边距（像素）"
          },
          "radius": {
            "type": "number",
            "minimum": 0,
            "description": "格子圆角（像素）"
          },
          "background": {
            "type": "string",
            "description": "#rrggbb 或 transparent"
          },
          "width": {
            "type": "integer",
            "minimum": 16,
            "description": "输出宽度（像素）；长图竖拼时为统一宽度"
          },
          "height": {
            "type": "integer",
            "minimum": 16,
            "description": "输出高度（像素）；长图横拼时为统一高度"
          },
          "overflow": {
            "type": "string",
            "enum": [
              "chunk",
              "first"
            ],
            "description": "图片多于格子数时：chunk 分组输出多张（默认），first 只拼前几张"
          },
          "remainder": {
            "type": "string",
            "enum": [
              "keep",
              "drop"
            ],
            "description": "最后一组不满时：keep 留空（默认），drop 丢弃"
          },
          "sort": {
            "type": "string",
            "enum": [
              "none",
              "name",
              "nameDesc"
            ],
            "description": "拼接顺序：none 按传入顺序（默认），name / nameDesc 按文件名"
          },
          "recursive": {
            "type": "boolean",
            "description": "展开文件夹时是否包含子文件夹，默认 false"
          },
          "output_dir": {
            "type": "string",
            "description": "导出目录的绝对路径；不填时导出到第一张源图所在的目录"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp",
              "avif"
            ],
            "description": "导出格式，默认 png"
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "jpeg / webp / avif 的质量，默认 90"
          },
          "name_template": {
            "type": "string",
            "description": "文件名模板（不含扩展名），可用 {name} {index} {date} {time}；重名时自动加序号，不会覆盖已有文件"
          }
        },
        "required": [
          "paths"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "导出的文件",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "failed": {
            "type": "array",
            "description": "读取失败、被跳过的输入",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "files",
          "failed"
        ]
      }
    },
    "run_workflow": {
      "description": "用用户在快拼图里保存的工作流（编辑、拼接、导出的组合）处理本地图片。workflow 来自 list_presets。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflow": {
            "type": "string",
            "description": "工作流的 id 或名称"
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "图片文件或文件夹的绝对路径；文件夹会展开为其中的图片（按文件名自然排序）"
          },
          "recursive": {
            "type": "boolean",
            "description": "展开文件夹时是否包含子文件夹，不填用工作流的设置"
          },
          "output_dir": {
            "type": "string",
            "description": "导出目录的绝对路径，代替工作流里设置的目录；不填按工作流的设置（「每次询问」改为下载目录）"
          }
        },
        "required": [
          "workflow",
          "paths"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "description": "导出的文件",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "width": {
                  "type": "integer"
                },
                "height": {
                  "type": "integer"
                }
              },
              "required": [
                "path"
              ]
            }
          },
          "failed": {
            "type": "array",
            "description": "读取失败、被跳过的输入",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "files",
          "failed"
        ]
      }
    }
  }
}
