{
  "name": "@whatevertools/cli",
  "version": "0.1.1",
  "description": "whatevertools command line: run plugins in a bare Electron launcher, check compatibility, and pack plugins for uTools, Electron or the web",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mowtwo/whatevertools.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "whatevertools": "dist/index.js",
    "wt": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./launcher": "./dist/launcher.js",
    "./dist/launcher": "./dist/launcher.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@whatevertools/core": "workspace:*",
    "@whatevertools/api": "workspace:*",
    "@whatevertools/compat-utools": "workspace:*",
    "@whatevertools/db-file": "workspace:*",
    "@whatevertools/electron": "workspace:*",
    "@whatevertools/web": "workspace:*",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "electron": ">=30"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  }
}
