{
  "name": "@whatevertools/utools",
  "version": "0.2.1",
  "description": "Type definitions for plugins that ship to uTools itself: window.utools typings and a plugin.json schema. Zero runtime by default; an optional tiny runtime implements the whatevertools native API on top of window.utools.",
  "license": "MIT",
  "homepage": "https://whatevertools.mowtwo.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mowtwo/whatevertools.git",
    "directory": "packages/utools"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./index.d.ts",
  "sideEffects": false,
  "files": [
    "index.d.ts",
    "namespace.d.ts",
    "plugin.schema.json",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./namespace": {
      "types": "./namespace.d.ts"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./plugin.schema.json": "./plugin.schema.json",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@whatevertools/api": "workspace:*",
    "@whatevertools/core": "workspace:*"
  },
  "peerDependencies": {
    "@whatevertools/api": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@whatevertools/api": {
      "optional": true
    }
  }
}
